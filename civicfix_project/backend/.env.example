# Copy this file to `.env` and fill in real values before running the project.

# --- Core ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# CivicFix uses MySQL by default (USE_SQLITE=False). Before running migrate,
# create the database once:
#   mysql -u root -p -e "CREATE DATABASE civicfix CHARACTER SET utf8mb4;"
# Then fill in your MySQL credentials below.
#
# If MySQL isn't available on this machine, set USE_SQLITE=True instead for
# an instant zero-config run -- no other settings need to change.
USE_SQLITE=False

DB_NAME=civicfix
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Production security (local development can leave these False/0).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Email (reserved for future notification emails) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# To send real emails via Gmail instead, switch to:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and fill these in (use a Gmail "App Password", not your normal password):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CivicFix <noreply@civicfix.local>
EMAIL_TIMEOUT=10
SEND_DEPARTMENT_EMAILS=True
FRONTEND_BASE_URL=http://127.0.0.1:5500

TIME_ZONE=Asia/Kathmandu

# Optional: path to Dikshya's trusted, trained SVM pipeline artifact.
# The saved object must implement predict([text]) and return CivicFix category values.
SVM_MODEL_PATH=
