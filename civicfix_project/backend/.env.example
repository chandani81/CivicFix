# Copy this file to `.env` and fill in real values before running the project.

# --- Core ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# CivicFix uses MySQL by default (USE_SQLITE=False). Before running migrate,
# create the database once:
#   mysql -u root -p -e "CREATE DATABASE civicfix CHARACTER SET utf8mb4;"
# Then fill in your MySQL credentials below.
#
# If MySQL isn't available on this machine, set USE_SQLITE=True instead for
# an instant zero-config run -- no other settings need to change.
USE_SQLITE=False

DB_NAME=civicfix
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True

# --- Email (reserved for future notification emails) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# To send real emails via Gmail instead, switch to:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and fill these in (use a Gmail "App Password", not your normal password):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CivicFix <noreply@civicfix.local>

TIME_ZONE=Asia/Kathmandu
